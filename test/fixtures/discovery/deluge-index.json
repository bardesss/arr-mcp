  "body": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\n    <head>\n        <title>Deluge WebUI 2.2.0</title>\n\n        <link rel=\"icon\" sizes=\"16x16\" type=\"image/png\"\n            href=\"/icons/deluge.png\"/>\n        <link rel=\"icon\" sizes=\"32x32\" type=\"image/png\"\n            href=\"/icons/deluge-32.png\"/>\n        <!-- For Chrome, Android, iOS and Windows touch shortcuts: -->\n        <link rel=\"icon\" sizes=\"192x192\" type=\"image/png\"\n            href=\"/icons/deluge-192.png\"/>\n        <link rel=\"icon\" sizes=\"512x512\" type=\"image/png\"\n            href=\"/icons/deluge-512.png\"/>\n        <link rel=\"apple-touch-icon-precomposed\"\n            href=\"/icons/deluge-apple-180.png\"/>\n        <meta name=\"msapplication-TileColor\" content=\"#599eee\">\n        <meta name=\"theme-color\" content=\"#599eee\">\n\n        <!-- Stylesheets -->\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/ext-all-notheme.css\"/>\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/ext-extensions.css\"/>\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"/css/deluge.css\"/>\n        <link rel=\"stylesheet\" type=\"text/css\" href=\"/themes/css/xtheme-gray.css\"/>\n\n        <script type=\"text/javascript\">\n        deluge = {\n            author: 'Deluge Team',\n            version: '2.2.0',\n            config: {\"theme\": \"gray\", \"sidebar_show_zero\": false, \"sidebar_multiple_filters\": true, \"show_session_speed\": false, \"base\": \"/\", \"first_login\": false}\n        }\n        </script>\n\n        <!-- Javascript -->\n        <script type=\"text/javascript\" src=\"/gettext.js\"></script>\n        <script type=\"text/javascript\" src=\"/js/ext-base.js\"></script>\n        <script type=\"text/javascript\" src=\"/js/ext-all.js\"></script>\n        <script type=\"text/javascript\" src=\"/js/ext-extensions.js\"></script>\n        <script type=\"text/javascript\" src=\"/js/deluge-all.js\"></script>\n        <script type=\"text/javascript\" src=\"/js/label/label.js\"></script>\n        <script type=\"text/javascript\">\n            Deluge.debug = false;\n        </script>\n    </head>\n    <body>\n        <div style=\"background-image: url('/themes/images/default/tree/loading.gif');\"></div>\n\n        <!-- Preload icon classes -->\n        <div class=\"ext-mb-error\"></div>\n        <div class=\"icon-ok\"></div>\n    </body>\n</html>\n"
