{
  "name": "arr-mcp",
  "version": "1.83.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "One MCP server for the whole self-hosted media stack: Radarr, Sonarr, Whisparr, Lidarr, Prowlarr, Bazarr, Jellyfin, Plex, Seerr, SABnzbd, NZBGet, Transmission, qBittorrent, Profilarr, Cleanuparr, Reclaimerr, Dispatcharr, Shelfmark, Grimmory.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bardesss/arr-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "specs:fetch": "bash scripts/fetch-specs.sh",
    "codegen": "node scripts/codegen.mjs",
    "icon:write": "node scripts/write-logo.ts",
    "capture": "node scripts/capture-fixtures.ts",
    "capture:webhooks": "node scripts/capture-webhooks.ts",
    "integration": "node scripts/integration.ts",
    "multi-instance": "node scripts/multi-instance-check.ts",
    "screenshots": "node scripts/screenshots.ts",
    "docs:tool-map": "node scripts/tool-map.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/hono": "^2.0.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "pino": "^10.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
