{
  "name": "arr-mcp",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "One MCP server for the whole self-hosted media stack: Radarr, Sonarr, Prowlarr, Bazarr, Jellyfin, Seerr, SABnzbd, Transmission.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bardesss/arr-mcp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "specs:fetch": "bash scripts/fetch-specs.sh",
    "codegen": "node scripts/codegen.mjs",
    "icon:write": "node scripts/write-logo.ts",
    "capture": "node scripts/capture-fixtures.ts",
    "integration": "node scripts/integration.ts",
    "multi-instance": "node scripts/multi-instance-check.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^13.0.2",
    "hono": "^4.13.0",
    "pino": "^10.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
